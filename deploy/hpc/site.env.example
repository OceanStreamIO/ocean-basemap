# =============================================================================
# deploy/hpc/site.env.example — copy to site.env and fill in
# =============================================================================
# site.env is gitignored. This repository is published, so an account name, a
# hostname or a filesystem path does not belong in it; the real values live in
# the private infrastructure notes and, in the cluster, in a ConfigMap that the
# Job references by name.
#
#   cp deploy/hpc/site.env.example deploy/hpc/site.env
#
# Every variable below is required. Nothing has a default, so a half-filled file
# stops the script with the list of what is missing instead of connecting
# somewhere unintended.
# =============================================================================

# --- Accounts and hosts ----------------------------------------------------
HPC_USER=                  # the machine username on the cluster
HPC_LOGIN_HOST=            # the login node that can reach the compute scheduler
HPC_XFER_HOST=             # the transfer node that can reach object storage
HPC_ACCOUNT=               # the accounting/Slurm account to charge

# --- Filesystems -----------------------------------------------------------
# Backed up, group-wide, and shared with other projects: code and logs only.
HPC_PROJ=
# Not backed up, and may be purged: this is where the several hundred gigabytes
# of inputs and rendered output go.
HPC_SCRATCH=

# --- Scheduler -------------------------------------------------------------
HPC_PARTITION=             # the CPU partition for whole-node jobs
HPC_QOS=                   # the quality of service to submit under
HPC_DEBUG_QOS=             # a short, high-priority QOS for smoke tests
# The node feature that selects a high-memory node, if the site has one. Only
# the raster render needs it; leave empty to stay on ordinary nodes.
HPC_CONSTRAINT=
# Memory is derived from the core count on some schedulers rather than requested.
HPC_MEM_PER_CORE_GB=
HPC_MEM_PER_CORE_GB_CONSTRAINED=

# --- Modules ---------------------------------------------------------------
# Comma-separated, NOT space-separated. This file is read two ways: sourced by
# the shell, where `VAR=a b` runs `b` as a command, and by
# `kubectl create configmap --from-env-file`, where quotes would land inside the
# value. A comma is the one separator both accept.
#
# Loaded before the virtual environment. Must provide the Python the wheelhouse
# was built for.
HPC_MODULES=
# Loaded to put the GDAL command-line tools on PATH. Order matters where the
# module system enforces prerequisites; give the full chain.
HPC_GDAL_MODULES=
# Where that GDAL installs its own Python bindings, for the wrapper scripts.
HPC_GDAL_PYTHON=
# The interpreter those bindings were built for.
HPC_GDAL_PYTHON_BIN=
# Include and library directories for building tippecanoe against the site's
# SQLite, and the module that provides them.
HPC_SQLITE_MODULE=
HPC_SQLITE_INCLUDE=
HPC_SQLITE_LIB=

# --- Object storage --------------------------------------------------------
HPC_RCLONE_REMOTE=         # the configured rclone remote name on the transfer host
HPC_RCLONE_BUCKET=         # the bucket that remote addresses
HPC_RCLONE_BIN=            # absolute path to rclone; it is not on PATH in batch jobs
HPC_XFER_RCLONE_CMD=       # the queued rclone wrapper (a plain job has no resolver)
HPC_DT_SLURM_CONF=         # the transfer suite's own Slurm configuration
# An anonymous remote for public cloud-hosted open data, as an rclone connection
# string. Used to pull the elevation tiles without routing them through here.
HPC_OPENDATA_REMOTE=

# --- SSH -------------------------------------------------------------------
HPC_SSH_KEY=               # private key already in authorized_keys on the cluster
HPC_KNOWN_HOSTS=           # pinned host keys; without this, first use is trusted
